<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>billpg.HashBackCore</PackageId>
    <Version>0.1.0</Version>
    <Authors>William Godfrey</Authors>
    <Company>billpg industries</Company>
    <Copyright>Copyright (c) 2026 William Godfrey</Copyright>
    <Description>Core building blocks for the HashBack authentication protocol - build and parse HashBack Authorization headers, compute salted verification hashes, and authenticate incoming requests against a pluggable policy. Does not perform HTTP requests itself.</Description>
    <PackageTags>authentication;security;http;tls</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/billpg/HashBack</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/billpg/HashBack</PackageProjectUrl>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- System.Text.Json is part of the runtime from net5.0 onward, but netstandard2.0 needs
       it as an explicit package reference. Supports .NET Framework back to 4.6.2. -->
  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

</Project>
