<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>e1da85aa-ce26-4716-8846-74ef6cd6c0a6</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Docs\GetCallRoot.md" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\www-hashback-dev\BuildHBDSite\SiteTemplate.xml" Link="Docs\SiteTemplate.xml" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Docs/GetHome.md" />
    <EmbeddedResource Include="Docs\GetCallRoot.md" />
    <EmbeddedResource Include="Docs\GetHashRoot.md" />
    <EmbeddedResource Include="Docs\GetHelloRoot.md" />
  </ItemGroup>

  <!-- ASP.NET Core shared framework -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- Add Swashbuckle for OpenAPI generation -->
  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.5.0" />
    <PackageReference Include="Markdig" Version="1.3.2" />
    <PackageReference Include="Swashbuckle.AspNetCore.Annotations" Version="10.2.3" />
  </ItemGroup>

  <!-- Correct WWW-Authenticate/Authorization header parsing and building -->
  <ItemGroup>
    <PackageReference Include="billpg.WWWAuthenticateTools" Version="0.1.0" />
  </ItemGroup>

  <!-- EF Core with the PostgreSQL provider for the hash store -->
  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.4">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\billpg.HashBackCore\billpg.HashBackCore.csproj" />
  </ItemGroup>
</Project>
