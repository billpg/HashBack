<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Docs\GetCallRoot.md" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\www-hashback-dev\BuildHBDSite\SiteTemplate.xml" Link="Docs\SiteTemplate.xml" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Docs/GetHome.md" />
    <EmbeddedResource Include="Docs\GetCallRoot.md" />
    <EmbeddedResource Include="Docs\GetHashRoot.md" />
    <EmbeddedResource Include="Docs\GetHelloRoot.md" />
  </ItemGroup>

  <!-- ASP.NET Core shared framework -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- Add Swashbuckle for OpenAPI generation -->
  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.5.0" />
    <PackageReference Include="Markdig" Version="1.3.2" />
    <PackageReference Include="Swashbuckle.AspNetCore.Annotations" Version="10.2.3" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\billpg.HashBackCore\billpg.HashBackCore.csproj" />
  </ItemGroup>
</Project>
